{
  "manifest_version": 3,
  "name": "GLR Copiloto ADS",
  "version": "1.2.0",
  "description": "Copiloto do Mercado Ads (só mostra): lê a tela de Product Ads e dá o veredito por campanha e por anúncio com o passo a passo exato do que fazer. Não clica, não digita e não salva nada no Mercado Livre. Com o login da GLR, mostra o pacote do dia do agente.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rrodqlejqyaoomutriiw.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GLR Copiloto ADS",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vendedores.mercadolivre.com.br/publicidade/*",
        "https://ads.mercadolivre.com.br/product-ads/*"
      ],
      "js": [
        "ponte.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vendedores.mercadolivre.com.br/publicidade/*",
        "https://ads.mercadolivre.com.br/product-ads/*"
      ],
      "js": [
        "analise.js",
        "inteligencia.js",
        "painel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
