{
  "manifest_version": 3,
  "name": "GLR Copiloto ADS",
  "version": "1.5.0",
  "description": "Copiloto do Mercado Ads: mostra na própria tela do Product Ads o que fazer em cada campanha e anúncio (selo com o valor, destaque de onde clicar e balão com o valor a colocar) e confere sozinho depois que você salva. Não clica, não digita e não salva nada no Mercado Livre.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rrodqlejqyaoomutriiw.supabase.co/*",
    "https://pa.mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GLR Copiloto ADS",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vendedores.mercadolivre.com.br/publicidade/*",
        "https://ads.mercadolivre.com.br/product-ads/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vendedores.mercadolivre.com.br/publicidade/*",
        "https://ads.mercadolivre.com.br/product-ads/*"
      ],
      "js": [
        "analise.js",
        "inteligencia.js",
        "painel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
