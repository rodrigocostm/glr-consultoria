{
  "crons": [
    {
      "path": "/api/push-cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/agente-cron",
      "schedule": "30 10 * * *"
    }
  ],
  "functions": {
    "api/adviser.js": {
      "maxDuration": 60
    },
    "api/generate-photo.js": {
      "maxDuration": 60
    },
    "api/anuncio-seo.js": {
      "maxDuration": 120
    },
    "api/tiops-market.js": {
      "maxDuration": 180
    },
    "api/agente-cron.js": {
      "maxDuration": 300
    },
    "api/agente-chat.js": {
      "maxDuration": 300
    },
    "api/chat-central.js": {
      "maxDuration": 300
    },
    "api/sync-dados.js": {
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/blog.js": {
      "maxDuration": 120
    },
    "api/atendimento.js": {
      "maxDuration": 60
    },
    "api/promos.js": {
      "maxDuration": 300
    },
    "api/portal-chat.js": {
      "maxDuration": 300
    },
    "api/push-cron.js": {
      "maxDuration": 300
    },
    "api/vendas-prejuizo.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://rrodqlejqyaoomutriiw.supabase.co wss://rrodqlejqyaoomutriiw.supabase.co https://mcp.tiops.com.br https://cdn.jsdelivr.net; worker-src 'self'" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/editoria/:id",
      "destination": "/api/blog?editoria=:id"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    }
  ]
}
