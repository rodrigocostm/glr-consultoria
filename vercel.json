{
  "crons": [
    {
      "path": "/api/push-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/agente-cron",
      "schedule": "30 10 * * *"
    }
  ],
  "functions": {
    "api/adviser.js": {
      "maxDuration": 60
    },
    "api/generate-photo.js": {
      "maxDuration": 60
    },
    "api/agente-cron.js": {
      "maxDuration": 300
    },
    "api/agente-chat.js": {
      "maxDuration": 300
    },
    "api/chat-central.js": {
      "maxDuration": 300
    },
    "api/sync-dados.js": {
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/blog.js": {
      "maxDuration": 120
    },
    "api/atendimento.js": {
      "maxDuration": 60
    },
    "api/promos.js": {
      "maxDuration": 300
    },
    "api/portal-chat.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/editoria/:id",
      "destination": "/api/blog?editoria=:id"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    }
  ]
}
